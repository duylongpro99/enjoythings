# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.srl
# Locally generated mTLS material (services/devtools/gen-certs.sh)
certs/
services/certs/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Next.js
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
*.tsbuildinfo
.next-env.d.ts

# Go
bin/
coverage.out
*.test

# Local data and generated state
.worktrees/
.claude/worktrees/
*.db
*.sqlite
*.sqlite3
*.log
logs/
reports/
exports/
chroma/
chromadb/
.chroma/
data/chroma/
session*.db
sessions.db

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Docker/local runtime
.tmp/
tmp/
# The Go `bin/` rule above also matches drills/bin/; keep the drill CLI tracked.
!drills/bin/
!drills/bin/**
# Drill lock and injection state
drills/.active
drills/.revert*
drills/.overrides/

values-secrets.yaml

# Terraform: state holds credentials, .terraform holds downloaded providers.
# The .terraform.lock.hcl files are committed on purpose.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
# kind provider writes a standalone kubeconfig named <cluster>-config next to its state
infra/terraform/**/*-config

# Terragrunt working directories
.terragrunt-cache/
