#!/bin/sh
# inject <primitive> [args...]
# Applies one primitive from target.yaml and records how to undo it in
# $DRILL_REVERT_LOG (one line per injection, applied in reverse by `revert`).
# data.exec is not undone here; `reset` returns state to pristine.
set -eu
. "$(dirname -- "$0")/lib.sh"

REVERT_LOG="${DRILL_REVERT_LOG:-$DRILLS_DIR/.revert}"
record_revert() { printf '%s\n' "$*" >> "$REVERT_LOG"; }

# set_env_override <component> <key> <value> — append one environment override
# and recreate the component. The first override for a component records a single
# `env.unset` revert line that drops every override and restores it. Shared by
# env.set, net.*, and dep.replace so the recreate/undo path lives in one place.
set_env_override() {
	_comp=$1
	_key=$2
	_val=$3
	mkdir -p "$OVERRIDES_DIR"
	_override="$OVERRIDES_DIR/$_comp.yml"
	if [ ! -f "$_override" ]; then
		printf 'services:\n  %s:\n    environment:\n' "$_comp" > "$_override"
		record_revert "env.unset $_comp"
	fi
	# Single-quoted YAML scalar so values that embed double quotes (e.g. a JSON
	# provider registry) stay intact; a literal single quote is doubled per YAML.
	_esc=$(printf '%s' "$_val" | sed "s/'/''/g")
	printf "      %s: '%s'\n" "$_key" "$_esc" >> "$_override"
	compose up -d --no-deps --force-recreate "$_comp"
}

primitive=${1:-}
[ -n "$primitive" ] || die "usage: inject <primitive> [args...]"
shift

case "$primitive" in
proc.stop)
	known_component "$1"
	compose stop "$1"
	record_revert "proc.start $1"
	;;
proc.start)
	known_component "$1"
	compose start "$1"
	record_revert "proc.stop $1"
	;;
proc.pause)
	known_component "$1"
	compose pause "$1"
	record_revert "proc.unpause $1"
	;;
proc.unpause)
	known_component "$1"
	compose unpause "$1"
	record_revert "proc.pause $1"
	;;
proc.kill)
	known_component "$1"
	compose kill -s SIGKILL "$1"
	record_revert "proc.start $1"
	;;
env.set)
	# env.set <component> KEY=VALUE — recreate the component with one override.
	known_component "$1"
	component=$1
	kv=${2:-}
	case "$kv" in *=*) ;; *) die "env.set needs KEY=VALUE" ;; esac
	set_env_override "$component" "${kv%%=*}" "${kv#*=}"
	;;
env.unset)
	# Internal: drop every override for a component and recreate it.
	known_component "$1"
	rm -f "$OVERRIDES_DIR/$1.yml"
	compose up -d --no-deps --force-recreate "$1"
	;;
net.latency)
	# net.latency <a> <b> <ms> — delay the a->b edge by <ms>. Toxiproxy sits on
	# the edge only because the client is re-pointed at it (no named networks),
	# so the edge must be one the edge table knows (drills/toxics/README.md).
	a=${1:-}; b=${2:-}; ms=${3:-}
	[ -n "$a" ] && [ -n "$b" ] && [ -n "$ms" ] || die "usage: net.latency <a> <b> <ms>"
	known_component "$a"; known_component "$b"
	# shellcheck disable=SC2046
	set -- $(edge_lookup "$a" "$b")
	client_env=$1; proxy=$2; listen=$3; upstream=$4; client_url=$5
	compose_with_toxiproxy up -d toxiproxy
	toxi_create "$proxy" "$listen" "$upstream"
	toxi_cli toxic add "$proxy" -t latency -a "latency=$ms" >/dev/null
	set_env_override "$a" "$client_env" "$client_url"
	record_revert "net.clear $proxy"
	;;
net.partition)
	# net.partition <a> <b> — sever the a->b edge (proxy disabled) while both
	# endpoints stay healthy. Produces connection failures, not hangs.
	a=${1:-}; b=${2:-}
	[ -n "$a" ] && [ -n "$b" ] || die "usage: net.partition <a> <b>"
	known_component "$a"; known_component "$b"
	# shellcheck disable=SC2046
	set -- $(edge_lookup "$a" "$b")
	client_env=$1; proxy=$2; listen=$3; upstream=$4; client_url=$5
	compose_with_toxiproxy up -d toxiproxy
	toxi_create "$proxy" "$listen" "$upstream"
	toxi_cli toggle "$proxy" >/dev/null
	set_env_override "$a" "$client_env" "$client_url"
	record_revert "net.clear $proxy"
	;;
net.clear)
	# Internal: delete a Toxiproxy proxy (and its toxics). The paired env.unset
	# restores the client's real upstream URL.
	proxy=${1:-}
	[ -n "$proxy" ] || die "net.clear needs a proxy name"
	toxi_cli delete "$proxy" >/dev/null 2>&1 || true
	;;
dep.replace)
	# dep.replace <dependency> <profile> — swap an external dependency for a
	# scripted chaos variant. Only llm-endpoint (the fraud worker's LLM) is
	# replaceable today: bring up the chaos server on the stack, then re-point the
	# worker's provider registry at it (drills/chaosllm/README.md).
	dep=${1:-}; profile=${2:-}
	[ -n "$dep" ] && [ -n "$profile" ] || die "usage: dep.replace <dependency> <profile>"
	[ "$dep" = llm-endpoint ] || die "dep.replace supports: llm-endpoint"
	case "$profile" in
	healthy|slow|errors|truncate|flaky) ;;
	*) die "unknown chaos LLM profile: $profile (healthy|slow|errors|truncate|flaky)" ;;
	esac
	CHAOS_LLM_PROFILE="$profile" compose_with_chaosllm up -d --build chaos-llm
	registry='{"providers":[{"id":"chaos","driver_type":"openai_compatible","base_url":"http://chaos-llm:18091/chaos/v1","api_key_env":"LOCAL_LLM_API_KEY","model":"chaos-model","timeout_seconds":5}]}'
	set_env_override fraud-worker LLM_PROVIDERS_JSON "$registry"
	set_env_override fraud-worker LLM_DEFAULT_PROVIDER chaos
	record_revert "dep.restore llm-endpoint"
	;;
dep.restore)
	# Internal: stop the chaos server. The paired env.unset fraud-worker restores
	# the real provider registry and recreates the worker against it.
	dep=${1:-}
	[ "$dep" = llm-endpoint ] || die "dep.restore supports: llm-endpoint"
	compose_with_chaosllm rm -sf chaos-llm >/dev/null 2>&1 || true
	;;
code.patch)
	# code.patch <ref> — apply a Tier-B logic fault to the build tree and rebuild.
	# Sealed and unsealed drills bake the patch into the run's tree at `drill
	# start` (spec §6); this case honours a code.patch injected mid-drill, and
	# operates on $BUILD_ROOT so it never touches the main checkout.
	ref=${1:-}
	[ -f "$ref" ] || die "code.patch needs a readable patch file"
	git -C "$BUILD_ROOT" apply "$ref" || die "code.patch: $ref did not apply to $BUILD_ROOT"
	compose up -d --build
	record_revert "code.unpatch $ref"
	;;
code.unpatch)
	# Internal: reverse a code.patch and rebuild.
	ref=${1:-}
	[ -f "$ref" ] || die "code.unpatch needs a readable patch file"
	git -C "$BUILD_ROOT" apply -R "$ref" || die "code.unpatch: $ref did not reverse in $BUILD_ROOT"
	compose up -d --build
	;;
data.exec)
	# data.exec <component> <script-file> — run SQL or shell against a store.
	known_component "$1"
	component=$1
	script=${2:-}
	[ -f "$script" ] || die "data.exec needs a script file"
	case "$component" in
	postgres|fraud-timescaledb) compose exec -T "$component" sh -c 'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' < "$script" ;;
	kafka) compose exec -T kafka sh < "$script" ;;
	*) die "data.exec supports postgres, fraud-timescaledb, kafka" ;;
	esac
	;;
*)
	die "unsupported primitive: $primitive (see target.yaml)"
	;;
esac
log "injected $primitive $*"
