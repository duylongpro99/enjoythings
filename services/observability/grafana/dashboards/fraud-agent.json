{
  "uid": "fraud-agent",
  "title": "Fraud Agent",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "title": "Scored count", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (action) (rate(fraud_transactions_scored_total[5m]))"}]},
    {"id": 2, "title": "Flag rate", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(fraud_transactions_scored_total{action=~\"flag|block\"}[5m])) / sum(rate(fraud_transactions_scored_total[5m]))"}]},
    {"id": 3, "title": "Risk score distribution", "type": "heatmap", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (le) (rate(fraud_risk_score_bucket[5m]))"}]},
    {"id": 4, "title": "Model latency", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.99, sum by (le, provider, model) (rate(fraud_model_latency_seconds_bucket[5m])))"}]},
    {"id": 5, "title": "Enrichment outcomes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (method, outcome) (rate(fraud_enrichment_calls_total[5m]))"}]},
    {"id": 6, "title": "Guard rejections", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (callback, reason) (rate(fraud_callback_rejections_total[5m]))"}]}
  ]
}
