LLM_PROVIDERS_JSON='{"providers":[{"id":"local","driver_type":"openai_compatible","base_url":"http://host.docker.internal:11434/v1","api_key_env":"LOCAL_LLM_API_KEY","model":"llama3.1","timeout_seconds":30}]}'
LLM_DEFAULT_PROVIDER=local
LOCAL_LLM_API_KEY=replace-me

# Services local development defaults only.
APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://enjoythings:enjoythings_dev_password@localhost:5432/enjoythings?sslmode=disable
JWT_SECRET=local-dev-jwt-secret-change-me
DB_MAX_CONNS=10

# Token verification. HS256 uses JWT_SECRET above. RS256 verifies tokens from an
# external issuer and needs only the public key, inline or from a mounted file;
# the file wins when both are set.
JWT_ALG=HS256
# JWT_PUBLIC_KEY_PEM=
# JWT_PUBLIC_KEY_FILE=/etc/enjoythings/jwt.pub

# gRPC listen address. Per-service defaults when unset:
# wallet :9090, ledger :9091, saga-orchestrator :9093, verification :9094.
# GRPC_ADDR=:9090

# gRPC client addresses used by the gateway, saga orchestrator, and fraud worker.
WALLET_GRPC_ADDR=127.0.0.1:9090
LEDGER_GRPC_ADDR=127.0.0.1:9091
SAGA_GRPC_ADDR=127.0.0.1:9093
VERIFICATION_GRPC_ADDR=127.0.0.1:9094

# Internal-gRPC mutual TLS (Go services). Off by default: transport stays
# insecure, unchanged. When true, all three file paths are required — each
# service presents its own leaf cert and verifies peers against the shared CA.
# Generate local material with: services/devtools/gen-certs.sh (or: make certs).
GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT_FILE=/certs/wallet.crt
# GRPC_TLS_KEY_FILE=/certs/wallet.key
# GRPC_TLS_CA_FILE=/certs/ca.crt

# The fraud worker uses its own prefix for the same feature.
FRAUD_GRPC_TLS_ENABLED=false
# FRAUD_GRPC_TLS_CERT_FILE=/certs/fraud-worker.crt
# FRAUD_GRPC_TLS_KEY_FILE=/certs/fraud-worker.key
# FRAUD_GRPC_TLS_CA_FILE=/certs/ca.crt

# Kafka transport and consumer groups.
KAFKA_BROKERS=127.0.0.1:9092
WALLET_OUTBOX_TOPIC=tx.initiated
LEDGER_CONSUMER_TOPIC=tx.initiated
LEDGER_CONSUMER_GROUP_ID=ledger-service
LEDGER_CONSUMER_ENABLED=true
SAGA_CONSUMER_GROUP_ID=saga-orchestrator
SAGA_CONSUMER_ENABLED=true

# Fraud review deadline. Unset or 0 keeps a review open until an operator decides
# it; a positive duration auto-rejects reviews older than that on each sweep.
SAGA_FRAUD_REVIEW_TTL=
SAGA_FRAUD_REVIEW_REAPER_INTERVAL=1m
PAYMENT_PROCESSOR_CONSUMER_GROUP=payment-processor
NOTIFICATION_CONSUMER_GROUP=notification-service

# Outbox relay polling. Each service has its own pair; all default to 100ms/100.
WALLET_OUTBOX_POLL_INTERVAL=100ms
WALLET_OUTBOX_BATCH_SIZE=100
SAGA_OUTBOX_POLL_INTERVAL=100ms
SAGA_OUTBOX_BATCH_SIZE=100
PAYMENT_PROCESSOR_OUTBOX_INTERVAL=100ms
PAYMENT_PROCESSOR_OUTBOX_BATCH_SIZE=100
VERIFICATION_OUTBOX_INTERVAL=100ms
VERIFICATION_OUTBOX_BATCH_SIZE=100

# Compliance retention. Both audit sweepers are off by default (0 = keep
# forever). SAGA_FRAUD_AUDIT_RETENTION is a Go duration (e.g. 2160h for 90
# days) applied to saga fraud audit rows of terminal sagas; rows for sagas still
# in flight are kept regardless. FRAUD_AUDIT_RETENTION_DAYS is a day count for
# completed fraud worker sessions. KAFKA_DLQ_RETENTION_MS is the retention.ms
# set on every *.dlq topic at creation; the default is 30 days.
SAGA_FRAUD_AUDIT_RETENTION=0
FRAUD_AUDIT_RETENTION_DAYS=0
KAFKA_DLQ_RETENTION_MS=2592000000

# Gateway rate limiting.
RATE_LIMIT_BURST=60
RATE_LIMIT_REFILL_EVERY=1s

# Payment execution against the local stub rail.
PAYMENT_RAIL_URL=http://127.0.0.1:18090
PAYMENT_RAIL_TIMEOUT=2s
# Forces the stub rail to sleep so timeout paths can be exercised.
# STUB_RAIL_TIMEOUT_SLEEP=3s

# Verification decision mode: auto, manual, or rules.
VERIFICATION_MODE=auto

# Telemetry. Traces are dropped when the endpoint is unset. The sampler ratio
# applies only outside local and dev, where every trace is sampled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=0.1

# Python fraud worker.
FRAUD_DATABASE_URL=postgres://fraud_worker:change-me@localhost:5433/fraud_audit
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
FRAUD_REQUEST_TOPIC=fraud.score.requested
FRAUD_CONSUMER_GROUP=fraud-agent
FRAUD_METRICS_PORT=9101
FRAUD_SCORE_THRESHOLD=0.75
FRAUD_BLOCK_THRESHOLD=0.90
FRAUD_PROMPT_MAX_CHARS=8000
FRAUD_RESPONSE_MAX_CHARS=4000
FRAUD_HISTORY_LIMIT=20

# Phase 4 local runtime credentials. Replace before starting Compose.
FRAUD_DB_NAME=fraud_audit
FRAUD_DB_USER=fraud_worker
FRAUD_DB_PASSWORD=change-me
FRAUD_DB_PORT=5433
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
